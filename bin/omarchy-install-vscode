#!/bin/bash

# Install VSCode and configure it.

echo "Installing VSCode..."

# Add Microsoft VSCode repo
curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | sudo gpg --dearmor -o /etc/apt/keyrings/microsoft.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main" | sudo tee /etc/apt/sources.list.d/vscode.list
sudo apt-get update
sudo apt-get install -y code

mkdir -p ~/.vscode ~/.config/Code/User

cat > ~/.vscode/argv.json << 'EOF'
{
  "password-store":"gnome-libsecret"
}
EOF

printf '{\n  "update.mode": "none"\n}\n' > ~/.config/Code/User/settings.json

omarchy-theme-set-vscode

setsid gtk-launch code
