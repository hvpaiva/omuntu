# Changes require a restart to take effect.

# Tell Hyprland it was started via a session manager (suppresses the warning)
export HYPRLAND_CMD=Hyprland

# Ensure Omuntu bins are in the path
export OMUNTU_PATH=$HOME/.local/share/omuntu
export PATH=$OMUNTU_PATH/bin:$PATH

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
omuntu-cmd-present mise && eval "$(mise activate bash --shims)"
