#!/bin/bash

# Update Flatpak packages if any are installed
if flatpak list --app 2>/dev/null | grep -q .; then
  if omuntu-pkg-aur-accessible; then
    echo -e "\e[32m\nUpdate Flatpak packages\e[0m"
    flatpak update -y
    echo
  else
    echo -e "\e[31m\nFlathub is unavailable (so skipping Flatpak updates)\e[0m"
    echo
  fi
fi
