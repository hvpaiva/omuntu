#!/bin/bash

# Snapshots are not supported on Ubuntu (out of scope)
# This is a stub to prevent errors from scripts that call omarchy-snapshot

COMMAND="$1"

case "$COMMAND" in
create)
  echo "Snapshots not available on Omuntu"
  ;;
restore)
  echo "Snapshots not available on Omuntu"
  ;;
*)
  echo "Usage: omarchy-snapshot <create|restore>" >&2
  exit 1
  ;;
esac

exit 0
