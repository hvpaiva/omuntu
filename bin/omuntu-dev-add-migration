#!/bin/bash

# Creates a new Omuntu migration named after the unix timestamp of the last commit.
# Only intended for Omuntu developers.

cd ~/.local/share/omuntu
migration_file="$HOME/.local/share/omuntu/migrations/$(git log -1 --format=%cd --date=unix).sh"
touch $migration_file

if [[ $1 != "--no-edit" ]]; then
  nvim $migration_file
fi

echo $migration_file
