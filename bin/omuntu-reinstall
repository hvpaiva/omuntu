#!/bin/bash
set -e

# Attempt to reinstall all default Omuntu packages and reset all the default configs.

echo -e "This will reinstall all the default Omuntu packages and reset all default configs.\nWarning: All user changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  omuntu-reinstall-git
  omuntu-reinstall-pkgs
  omuntu-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && omuntu-system-reboot
fi
