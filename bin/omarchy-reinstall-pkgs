#!/bin/bash
set -e

# Reinstall all default Omuntu packages.

OMUNTU_PATH=${OMUNTU_PATH:-$HOME/.local/share/omuntu}

# Ensure all packages are installed
mapfile -t apt_packages < <(grep -v '^#' "$OMUNTU_PATH/install/packages/apt.packages" | grep -v '^$')
sudo apt-get update
sudo apt-get install -y "${apt_packages[@]}"

mapfile -t ppa_packages < <(grep -v '^#' "$OMUNTU_PATH/install/packages/ppa.packages" | grep -v '^$')
sudo apt-get install -y "${ppa_packages[@]}"
