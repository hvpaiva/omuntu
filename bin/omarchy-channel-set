#!/bin/bash

# Set the Omuntu channel, which dictates what git branch is used.

if (($# == 0)); then
  echo "Usage: omarchy-channel-set [stable|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") omarchy-branch-set "master" ;;
"dev") omarchy-branch-set "dev" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

omarchy-update -y
