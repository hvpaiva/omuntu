#!/bin/bash
set -e

# Overwrite all user configs with the Omuntu defaults.

if (( EUID == 0 )); then
  echo "Error: This script should not be run as root"
  exit 1
fi

echo "Resetting all Omuntu configs"
cp -R ~/.local/share/omuntu/config/* ~/.config/
cp ~/.local/share/omuntu/default/bashrc ~/.bashrc
echo '[[ -f ~/.bashrc ]] && . ~/.bashrc' | tee ~/.bash_profile >/dev/null

$(bash $OMUNTU_PATH/install/config/theme.sh)

omuntu-nvim-setup
