#!/bin/bash

if [[ -z $1 ]]; then
  echo "Usage: omuntu-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/omuntu/current/theme"
NEXT_THEME_PATH="$HOME/.config/omuntu/current/next-theme"
USER_THEMES_PATH="$HOME/.config/omuntu/themes"
OMUNTU_THEMES_PATH="$OMUNTU_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $OMUNTU_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$OMUNTU_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate dynamic configs
omuntu-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/omuntu/current/theme.name"

# Change background with theme
omuntu-theme-bg-next

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  omuntu-restart-waybar
fi
omuntu-restart-swayosd
omuntu-restart-terminal
omuntu-restart-hyprctl
omuntu-restart-btop
omuntu-restart-opencode
omuntu-restart-mako

# Change app-specific themes
omuntu-theme-set-gnome
omuntu-theme-set-browser
omuntu-theme-set-vscode
omuntu-theme-set-obsidian
omuntu-theme-set-keyboard

# Call hook on theme set
omuntu-hook theme-set "$THEME_NAME"
