#!/bin/bash

# Launch the passed in URL as a web app in the default browser (or chromium if the default doesn't support --app).

browser=$(xdg-settings get default-web-browser 2>/dev/null)

case $browser in
google-chrome* | brave-browser* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium-browser.desktop" ;;
esac

browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1)

if [[ -z $browser_exec ]]; then
  # Fallback: find chromium binary directly
  browser_exec=$(command -v chromium-browser || command -v chromium || echo "")
fi

if [[ -z $browser_exec ]]; then
  notify-send "App failure" "No Chromium-compatible browser found" 2>/dev/null
  exit 1
fi

exec setsid uwsm-app -- "$browser_exec" --app="$1" "${@:2}"
