#!/bin/bash

# Display installation logs and guide user to report issues on GitHub

SUPPORT_URL="https://github.com/hvpaiva/omuntu/issues"
LOG_TYPE="${1:-install}"

case "$LOG_TYPE" in
install)
  LOG_FILE="/var/log/omuntu-install.log"
  if [[ ! -f "$LOG_FILE" ]]; then
    echo "No install log found at $LOG_FILE"
    exit 1
  fi
  echo "=== Installation Log (last 50 lines) ==="
  echo ""
  tail -n 50 "$LOG_FILE"
  ;;
this-boot)
  echo "=== Current Boot Log (last 50 lines) ==="
  echo ""
  journalctl -b 0 --no-pager | tail -n 50
  ;;
last-boot)
  echo "=== Previous Boot Log (last 50 lines) ==="
  echo ""
  journalctl -b -1 --no-pager | tail -n 50
  ;;
*)
  echo "Usage: $0 [install|this-boot|last-boot]"
  exit 1
  ;;
esac

echo ""
echo "────────────────────────────────────────────"
echo "To report an issue, open:"
echo "  $SUPPORT_URL"
echo ""
echo "Include the relevant log output above in your report."
echo "Full install log: /var/log/omuntu-install.log"
echo "────────────────────────────────────────────"
