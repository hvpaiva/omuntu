#!/bin/bash

echo

if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
  gum confirm "Linux kernel has been updated. Reboot?" && omuntu-system-reboot
elif [[ -f $HOME/.local/state/omuntu/reboot-required ]]; then
  gum confirm "Updates require reboot. Ready?" && omuntu-system-reboot
fi

running_hyprland=$(readlink /proc/$(pgrep -x Hyprland)/exe 2>/dev/null)
if [[ $running_hyprland == *"(deleted)"* ]]; then
  gum confirm "Hyprland has been updated. Reboot?" && omuntu-system-reboot
fi

for file in "$HOME"/.local/state/omuntu/restart-*-required; do
  if [[ -f $file ]]; then
    filename=$(basename "$file")
    service="${filename#restart-}"
    service="${service%-required}"
    echo "Restarting $service"
    omuntu-state clear "$filename"
    omuntu-restart-"$service"
  fi
done
