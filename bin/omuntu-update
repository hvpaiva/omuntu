#!/bin/bash

set -e

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://github.com/hvpaiva/omuntu/discord\033[0m"' ERR

if [[ $1 == "-y" ]] || omuntu-update-confirm; then
  omuntu-snapshot create || (($? == 127))
  omuntu-update-git
  omuntu-update-perform
fi
